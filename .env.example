# EvalGate talks to any OpenAI-compatible API. The agent and the simulated callers can use
# different providers, which helps stretch free-tier quotas. Run `uv run evalgate check` after
# editing this file to confirm keys and model ids work.

# ---- Free setup (no credit card) ----
# Agent: Google Gemini free tier. Key from aistudio.google.com/apikey
EVALGATE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVALGATE_LLM_API_KEY=replace-me
EVALGATE_LLM_MODEL=gemini-3.1-flash-lite

# Simulated callers: Groq free tier. Key from console.groq.com/keys
EVALGATE_SIM_BASE_URL=https://api.groq.com/openai/v1
EVALGATE_SIM_API_KEY=replace-me
EVALGATE_SIM_MODEL=openai/gpt-oss-120b

# Free tiers allow a few at a time; going faster just burns retries.
EVALGATE_EVAL_CONCURRENCY=1

# ---- Paid setup (open-weight model, faster) ----
# EVALGATE_LLM_BASE_URL=https://api.together.ai/v1
# EVALGATE_LLM_API_KEY=replace-me
# EVALGATE_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput
# (leave the SIM_ lines empty to reuse the agent's endpoint for callers)

# SQLite by default. For Postgres from docker-compose:
# EVALGATE_DATABASE_URL=postgresql+asyncpg://evalgate:evalgate@localhost:5432/evalgate
