# Any OpenAI-compatible endpoint serving an open-weight model.
# Together:  https://api.together.xyz/v1     model e.g. Qwen/Qwen3-235B-A22B-Instruct-2507-tput
# Fireworks: https://api.fireworks.ai/inference/v1
# Groq:      https://api.groq.com/openai/v1
EVALGATE_LLM_BASE_URL=https://api.together.xyz/v1
EVALGATE_LLM_API_KEY=replace-me
EVALGATE_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput

# Postgres from docker-compose; tests use SQLite automatically.
EVALGATE_DATABASE_URL=postgresql+asyncpg://evalgate:evalgate@localhost:5432/evalgate
